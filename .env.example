# Copy to .env and fill in. NEVER commit .env. Every value below needs YOUR account or key
# (see docs/HUMAN_TODO.md). Empty values disable the related feature.

# --- Local stack ---
POSTGRES_PASSWORD=change-me-local-only
LOG_LEVEL=info
# true = skip feeds whose licence forbids commercial use (see docs/data_licenses.md)
COMMERCIAL_MODE=false

# --- Extension build ---
# Backend base URL compiled into the extension. Empty = fully offline extension.
VITE_API_BASE=

# --- Phishing feeds ---
PHISHTANK_APP_KEY=
OPENPHISH_PREMIUM_URL=

# --- Google Safe Browsing (optional cross-check, not used by default) ---
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Payments (phase v3) ---
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_TIER1_MONTHLY=
PADDLE_PRICE_TIER2_MONTHLY=
PADDLE_PRICE_TIER3_MONTHLY=
# Razorpay placeholders (only if you choose Razorpay for India — decision #4 in PLAN.md)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# HMAC secret used to sign license keys issued by our backend
LICENSE_SIGNING_SECRET=

# --- Chrome Web Store publishing (CI) ---
CWS_EXTENSION_ID=
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# --- Cloud hosting ---
DEPLOY_REGION=
