{
  "name": "phishguard-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "wasm-features": "tsx scripts/wasm_features.ts",
    "build:fast": "node scripts/build.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
